# Prewarmed agent image (generated by pi-cnb-cloud).
# CNB builds this once per Dockerfile change and reuses it via docker.build cache.
FROM node:22-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      jq \
      python3 \
      ripgrep \
 && rm -rf /var/lib/apt/lists/*

# The coding agent itself. Pin a version if you need reproducibility.
RUN npm install -g @earendil-works/pi-coding-agent --no-fund --no-audit

ENV PI_SKIP_VERSION_CHECK=1 \
    NODE_OPTIONS=--max-old-space-size=4096

WORKDIR /workspace